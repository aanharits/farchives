---
import SpotifyWidget from "./SpotifyWidget.astro";
---

<section id="contact" class="py-20 overflow-hidden">
  <div class="max-w-6xl mx-auto px-4">
    <!-- Mobile/Tablet Layout: Stacked -->
    <div class="block lg:hidden">
      <div class="relative">
        <!-- Circle - Positioned left -->
        <div
          class="absolute -left-12 sm:-left-16 top-0 w-52 sm:w-64 h-52 sm:h-64 rounded-full bg-[var(--sec)]"
          data-contact-circle
        >
        </div>

        <!-- Content below circle -->
        <div class="relative pt-32 sm:pt-48">
          <!-- Title -->
          <h2
            class="text-5xl sm:text-5xl font-serif italic text-[var(--white)] leading-[0.9] mb-8 sm:mb-8"
            data-contact-title
          >
            Let's<br />Connect
          </h2>

          <!-- Description -->
          <p
            class="text-sm text-[var(--white-icon)] leading-relaxed mb-8"
            data-contact-content
          >
            I'm remote-friendly and always open to new opportunities. Feel free
            to email me at <a
              href="mailto:farhan.harits05@gmail.com"
              class="text-[var(--white)] hover:text-[var(--sec)] transition-colors font-medium"
              >farhan.harits05@gmail.com</a
            >. You can also find me on <a
              href="https://github.com/aanharits"
              target="_blank"
              class="text-[var(--white)] hover:text-[var(--sec)] transition-colors font-medium"
              >GitHub</a
            > and
            <a
              href="https://www.linkedin.com/in/farhan-harits-prakoso/"
              target="_blank"
              class="text-[var(--white)] hover:text-[var(--sec)] transition-colors font-medium"
              >LinkedIn</a
            >, for more details.
          </p>

          <!-- Spotify Section -->
          <div data-contact-content>
            <SpotifyWidget class="mt-8" />
          </div>
        </div>
      </div>
    </div>

    <!-- Desktop Layout: Side by side -->
    <div class="hidden lg:block">
      <div class="relative min-h-[450px]">
        <!-- Decorative Circle -->
        <div
          class="absolute left-0 md:left-4 top-0 w-[300px] h-[300px] lg:w-[400px] lg:h-[400px] rounded-full bg-[var(--sec)]"
          data-contact-circle-desktop
        >
        </div>

        <!-- Let's Connect Title -->
        <div
          class="absolute left-8 md:left-12 lg:left-24 bottom-8 z-10"
          data-contact-title-desktop
        >
          <h2
            class="text-6xl lg:text-8xl font-serif italic text-[var(--white)] leading-[0.9]"
          >
            Let's<br />Connect
          </h2>
        </div>

        <!-- Description & Spotify - Right side -->
        <div
          class="absolute right-0 top-1/2 -translate-y-1/2 w-[55%] md:w-[50%] lg:w-[45%]"
          data-contact-content-desktop
        >
          <p
            class="text-base lg:text-lg text-[var(--white-icon)] leading-relaxed mb-6"
          >
            I'm remote-friendly and always open to new opportunities. Feel free
            to email me at <a
              href="mailto:farhan.harits05@gmail.com"
              class="text-[var(--white)] hover:text-[var(--sec)] transition-colors font-medium"
              >farhan.harits05@gmail.com</a
            >. You can also find me on <a
              href="https://github.com/aanharits"
              target="_blank"
              class="text-[var(--white)] hover:text-[var(--sec)] transition-colors font-medium"
              >GitHub</a
            > and
            <a
              href="https://www.linkedin.com/in/farhan-harits-prakoso/"
              target="_blank"
              class="text-[var(--white)] hover:text-[var(--sec)] transition-colors font-medium"
              >LinkedIn</a
            >, for more details.
          </p>

          <!-- Spotify Section -->
          <SpotifyWidget class="mt-8" />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    // --- GSAP Animations ---

    const prefersReduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const isMobile = window.innerWidth < 1024;
    const dur = prefersReduced ? 0.01 : 0.8;

    if (isMobile) {
      // Mobile animations
      gsap.from("[data-contact-circle]", {
        scale: 0,
        opacity: 0,
        duration: dur * 1.2,
        ease: "back.out(1.2)",
        scrollTrigger: {
          trigger: "#contact",
          start: "top 85%",
          toggleActions: "play none none none",
        },
      });

      gsap.from("[data-contact-title]", {
        x: -30,
        opacity: 0,
        duration: dur,
        ease: "power3.out",
        scrollTrigger: {
          trigger: "#contact",
          start: "top 75%",
          toggleActions: "play none none none",
        },
      });

      gsap.from("[data-contact-content]", {
        y: 25,
        opacity: 0,
        duration: dur * 0.9,
        stagger: 0.15,
        ease: "power3.out",
        scrollTrigger: {
          trigger: "#contact",
          start: "top 70%",
          toggleActions: "play none none none",
        },
      });
    } else {
      // Desktop animations
      gsap.from("[data-contact-circle-desktop]", {
        scale: 0,
        opacity: 0,
        duration: dur * 1.3,
        ease: "back.out(1.2)",
        scrollTrigger: {
          trigger: "#contact",
          start: "top 75%",
          toggleActions: "play none none none",
        },
      });

      gsap.from("[data-contact-title-desktop]", {
        x: -50,
        opacity: 0,
        duration: dur,
        ease: "power3.out",
        scrollTrigger: {
          trigger: "#contact",
          start: "top 70%",
          toggleActions: "play none none none",
        },
      });

      gsap.from("[data-contact-content-desktop]", {
        x: 50,
        opacity: 0,
        duration: dur,
        ease: "power3.out",
        scrollTrigger: {
          trigger: "#contact",
          start: "top 65%",
          toggleActions: "play none none none",
        },
      });
    }
  });
</script>

