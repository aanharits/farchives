---
import Layout from "@/layouts/Layout.astro";
import { researchPaper } from "@/data/research";
---

<Layout title="The Research Chronicle | Astro vs. React Performance Trial">
  <main
    class="min-h-screen w-full bg-[var(--background)] py-6 sm:py-10 px-3 sm:px-6 lg:px-12"
  >
    <!-- Top Back Bar -->
    <div
      class="max-w-6xl mx-auto flex items-center justify-between pb-4 mb-4 text-xs font-mono text-[var(--white-icon)]"
    >
      <a
        href="/"
        class="inline-flex items-center gap-2 hover:text-[var(--white)] transition-colors group"
      >
        <span class="group-hover:-translate-x-1 transition-transform">←</span>
        <span>Back to Portfolio (Home)</span>
      </a>

      <div class="flex items-center gap-3">
        <span class="text-[var(--sec)]">Archive Dispatch No. 50423457</span>
        <span class="opacity-40">•</span>
      </div>
    </div>

    <!-- AUTHENTIC WARM NEWSPAPER BROADSHEET SHEET -->
    <article
      class="max-w-6xl mx-auto rounded-2xl border-2 border-black/80 bg-[#f0e9d4] text-[#161616] shadow-2xl p-6 sm:p-8 lg:p-10 font-serif select-none"
    >
      <!-- Top Newspaper Ear & Date Bar -->
      <div
        class="flex flex-wrap items-center justify-between text-[10px] font-mono uppercase tracking-widest text-[#555] border-b border-black/40 pb-2"
      >
        <span>Jakarta Edition • 2026</span>
        <span class="font-bold text-black">No. 50423457 // Vol. 2026</span>
        <span>Price: Open Access Academic Edition</span>
      </div>

      <!-- Classic Newspaper Double-Rule Masthead -->
      <header
        class="border-y-2 border-double border-black py-4 my-3 text-center"
      >
        <div
          class="text-[10px] font-mono uppercase tracking-widest text-[#555] mb-1"
        >
          Universitas Gunadarma • Faculty of Industrial Technology • Department
          of Informatics
        </div>
        <h1
          class="text-3xl sm:text-5xl lg:text-6xl font-black font-serif tracking-wider uppercase text-black leading-none"
        >
          The Research Chronicle
        </h1>
        <p
          class="text-xs sm:text-sm italic text-[#444] tracking-normal mt-2 max-w-2xl mx-auto"
        >
          Special Investigative Dispatch on Modern Web Architecture, Core Web
          Vitals, and Server Concurrency
        </p>
      </header>

      <!-- Sub-Masthead Specs Strip -->
      <div
        class="flex flex-wrap items-center justify-between font-mono text-[9px] sm:text-[10px] uppercase tracking-wider text-[#444] border-b border-black/30 pb-2 mb-6"
      >
        <span>Lead Researcher: Farhan Harits Prakoso</span>
        <span>Advisor: Dwi Widiastuti, S.Kom., MMSI.</span>
        <span>Defended: September 01, 2026</span>
        <span>Scope: 126 Pages, 5 Chapters</span>
      </div>

      <!-- 3-COLUMN EDITORIAL GRID -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10">
        <!-- COLUMN 1 (LEFT - 3 COLS): Author Context & Problem Statement -->
        <aside
          class="lg:col-span-3 flex flex-col justify-between gap-6 pb-6 lg:pb-0 border-b lg:border-b-0 lg:border-r border-black/25 lg:pr-8"
        >
          <div class="flex flex-col gap-5">
            <div
              class="flex items-center justify-between border-b border-black/20 pb-1.5 font-mono text-[10px] uppercase tracking-wider text-[#555]"
            >
              <span class="font-bold text-black">( 01 ) Context</span>
              <span>Ref. PI-2026</span>
            </div>

            <div class="flex flex-col gap-2">
              <span
                class="text-[9px] font-mono uppercase tracking-wider text-[#74824a] font-bold"
              >
                Undergraduate Investigator
              </span>
              <h2
                class="text-lg font-bold text-black tracking-tight leading-snug"
              >
                Farhan Harits Prakoso
              </h2>
              <p class="text-[11px] font-mono text-[#555]">
                Department of Informatics, Universitas Gunadarma
              </p>
            </div>

            <div
              class="text-[11px] font-sans leading-relaxed text-[#2a2a2a] space-y-3"
            >
              <p class="text-justify">
                <span
                  class="float-left text-3xl font-serif font-black mr-1.5 leading-none text-black"
                  >A</span
                >ccording to the <em>Stack Overflow Developer Survey (2025)</em
                >, React JS powers 44.7% of professional workflows globally.
                Confirmed by the <em>State of JavaScript (2024)</em>, where
                React holds 67% workplace adoption—over double Vue (31%) and
                Angular (28%)—it has become the unquestioned industry default.
              </p>
              <p class="text-justify">
                However, this ubiquity creates an architectural mismatch. Teams
                routinely deploy React's Client-Side Rendering (CSR) for static
                landing pages. While Google & SOASTA (2017) demonstrate that a
                1-second delay slashes conversions by 20%, CSR forces mobile
                devices to parse monolithic JavaScript bundles before visual
                text or images can even appear.
              </p>
              <p class="text-justify">
                In response, Astro's official documentation (<em
                  >Astro Docs, 2024</em
                >) prominently asserts that its Islands Architecture delivers
                superior speed and near-zero payloads. Yet, as argued in this
                thesis, technical self-claims cannot merely be assumed from
                theoretical specs—they demand rigorous empirical validation.
                This 126-page trial provides the first simultaneous benchmark
                comparing Astro and React across both client Web Vitals and
                300-thread server stress.
              </p>
            </div>

            <!-- Authentic Newspaper Gazette Document Box -->
            <div
              class="border-2 border-black bg-[#e5dcbe] p-3.5 font-mono text-[10px] text-black space-y-1.5"
            >
              <div
                class="flex items-center justify-between border-b-2 border-black pb-1"
              >
                <span
                  class="font-bold text-[9px] uppercase tracking-wider text-black"
                  >Gazette Metadata</span
                >
                <span class="text-[9px] text-[#666]">UG // 2026</span>
              </div>
              <div class="space-y-1 text-[9px] pt-1">
                <div
                  class="flex justify-between border-b border-black/20 pb-0.5"
                >
                  <span class="text-[#555]">Document:</span>
                  <span class="font-bold text-black"
                    >Undergraduate Thesis (PI)</span
                  >
                </div>
                <div
                  class="flex justify-between border-b border-black/20 pb-0.5"
                >
                  <span class="text-[#555]">Length:</span>
                  <span class="font-bold text-black">126 Pages, 5 Chapters</span
                  >
                </div>
                <div
                  class="flex justify-between border-b border-black/20 pb-0.5"
                >
                  <span class="text-[#555]">Instruments:</span>
                  <span class="font-bold text-black">Lighthouse, JMeter</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-[#555]">Concurrency:</span>
                  <span class="font-bold text-black">Up to 300 Users</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Bottom Column Footnote -->
          <div
            class="pt-4 border-t border-black/25 font-mono text-[10px] text-[#555]"
          >
            Farhan Harits Prakoso © 2026
          </div>
        </aside>

        <!-- COLUMN 2 (CENTER - 6 COLS): Lead Story, Proof Callouts & Telemetry Tables -->
        <section
          class="lg:col-span-6 flex flex-col gap-6 pb-6 lg:pb-0 border-b lg:border-b-0 lg:border-r border-black/25 lg:pr-8"
        >
          <!-- Lead Headline -->
          <div class="border-b border-black/30 pb-3">
            <h2
              class="text-xl sm:text-2xl lg:text-3xl font-black text-black tracking-tight leading-snug font-serif"
            >
              The Frontend Paradox: Astro Wins the Browser, Yet React Holds the
              Server Gate
            </h2>
            <p
              class="text-xs font-serif italic text-[#444] mt-1.5 leading-relaxed"
            >
              A 126-page empirical trial uncovers why Astro paints 47.8% faster
              in the browser, while React dispatches packets 11ms quicker under
              300-thread concurrency.
            </p>
          </div>

          <!-- Newspaper Stat Ledger Boxes (Square border-2 border-black, authentic print style) -->
          <div class="grid grid-cols-2 gap-4">
            <div
              class="border-2 border-black bg-[#e5dcbe] p-3.5 flex flex-col justify-between font-mono text-black"
            >
              <div
                class="flex justify-between border-b border-black/30 pb-1 text-[9px] uppercase tracking-wider text-[#555]"
              >
                <span>Telemetry A</span>
                <span class="font-bold text-purple-900">Astro Advantage</span>
              </div>
              <div class="py-2">
                <span
                  class="text-3xl sm:text-4xl font-bold tracking-tight text-black font-serif"
                >
                  -47.8<span class="text-purple-800 text-xl font-mono">%</span>
                </span>
                <span
                  class="text-[9px] uppercase tracking-wider text-[#555] block font-mono mt-0.5"
                >
                  LCP Mobile Latency
                </span>
              </div>
              <p
                class="text-[10px] text-[#333] font-sans leading-tight border-t border-black/20 pt-1"
              >
                Astro painted hero images in 1.9s vs. React's 3.6s on simulated
                mobile networks.
              </p>
            </div>

            <div
              class="border-2 border-black bg-[#e5dcbe] p-3.5 flex flex-col justify-between font-mono text-black"
            >
              <div
                class="flex justify-between border-b border-black/30 pb-1 text-[9px] uppercase tracking-wider text-[#555]"
              >
                <span>Telemetry B</span>
                <span class="font-bold text-purple-900">Zero Blocking</span>
              </div>
              <div class="py-2">
                <span
                  class="text-3xl sm:text-4xl font-bold tracking-tight text-black font-serif"
                >
                  0 <span class="text-purple-800 text-xl font-mono">ms</span>
                </span>
                <span
                  class="text-[9px] uppercase tracking-wider text-[#555] block font-mono mt-0.5"
                >
                  Total Blocking Time
                </span>
              </div>
              <p
                class="text-[10px] text-[#333] font-sans leading-tight border-t border-black/20 pt-1"
              >
                Zero main-thread blocking on Astro; React held main thread for
                120ms during hydration.
              </p>
            </div>
          </div>

          <!-- The Architectural Root Cause Box -->
          <div
            class="border-2 border-black bg-[#ded4b7] p-3.5 font-mono text-[10px]"
          >
            <span
              class="text-[9px] uppercase tracking-wider text-black font-bold block mb-2 border-b-2 border-black pb-1"
            >
              Architectural Root Cause Comparison
            </span>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div class="flex flex-col gap-1 border-r border-black/20 pr-2">
                <span class="font-bold text-purple-900 text-[10px] uppercase"
                  >ASTRO (ISLANDS)</span
                >
                <p class="font-sans text-[10px] text-[#333] leading-snug">
                  Server outputs pre-rendered static HTML. Zero runtime JS is
                  downloaded for static sections. Browser paints DOM immediately
                  upon arrival.
                </p>
              </div>
              <div class="flex flex-col gap-1">
                <span class="font-bold text-sky-900 text-[10px] uppercase"
                  >REACT (CSR)</span
                >
                <p class="font-sans text-[10px] text-[#333] leading-snug">
                  Browser receives empty root container. Main thread must
                  download, parse, and execute hefty JS bundles before visual
                  elements appear.
                </p>
              </div>
            </div>
          </div>

          <!-- Telemetry Table 1: Core Web Vitals (Newspaper Ledger Style) -->
          <div class="flex flex-col gap-1.5">
            <div
              class="flex justify-between items-baseline font-mono text-[10px]"
            >
              <span class="font-bold text-black uppercase tracking-wider">
                Table 1: Core Web Vitals (PageSpeed & Lighthouse)
              </span>
              <span class="text-[#666]">Simulated Mobile & Desktop</span>
            </div>

            <!-- Newspaper Ledger Table 1 -->
            <div class="overflow-x-auto border-2 border-black bg-white/70">
              <table class="w-full text-left font-mono text-xs border-collapse">
                <thead
                  class="border-b-2 border-black bg-[#ded4b7] text-black text-[9px] uppercase tracking-wider"
                >
                  <tr>
                    <th class="py-2 px-3 border-r border-black/20"
                      >Metric Parameter</th
                    >
                    <th
                      class="py-2 px-3 border-r border-black/20 text-purple-900 font-extrabold"
                      >Astro JS</th
                    >
                    <th
                      class="py-2 px-3 border-r border-black/20 text-sky-900 font-extrabold"
                      >React JS</th
                    >
                    <th class="py-2 px-3 text-right">Advantage</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-black/20 text-[11px]">
                  {
                    researchPaper.metrics.pageSpeed.map((row) => (
                      <tr class="odd:bg-transparent even:bg-black/[0.03]">
                        <td class="py-2 px-3 font-semibold text-black border-r border-black/20">
                          {row.metric}
                        </td>
                        <td class="py-2 px-3 font-bold text-purple-900 border-r border-black/20">
                          {row.astro}
                        </td>
                        <td class="py-2 px-3 font-bold text-sky-900 border-r border-black/20">
                          {row.react}
                        </td>
                        <td class="py-2 px-3 text-right font-black text-black">
                          {row.delta}
                        </td>
                      </tr>
                    ))
                  }
                  {
                    researchPaper.metrics.lighthouseMobile.map((row) => (
                      <tr class="odd:bg-transparent even:bg-black/[0.03]">
                        <td class="py-2 px-3 font-semibold text-black border-r border-black/20">
                          {row.metric}
                        </td>
                        <td class="py-2 px-3 font-bold text-purple-900 border-r border-black/20">
                          {row.astro}
                        </td>
                        <td class="py-2 px-3 font-bold text-sky-900 border-r border-black/20">
                          {row.react}
                        </td>
                        <td class="py-2 px-3 text-right font-black text-black">
                          {row.delta}
                        </td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>

            <!-- Key Takeaways: Why React Lags in Table 1 (Concise Core Rationale) -->
            <div
              class="p-3 bg-[#e5dcbe] border-l-4 border-purple-800 border-y border-r border-black/30 font-sans text-[10.5px] leading-relaxed text-[#222]"
            >
              <div
                class="flex items-center justify-between border-b border-black/20 pb-1 mb-1.5 font-mono text-[9px] uppercase tracking-wider"
              >
                <span class="font-bold text-purple-950"
                  >Key Takeaway // Why React Lags in Browser Rendering</span
                >
                <span class="text-[#666]">Chapter IV Analysis</span>
              </div>
              <div class="space-y-1.5">
                <p>
                  <strong class="font-bold text-purple-950"
                    >Hydration Overhead:</strong
                  > React's Client-Side Rendering sends an empty root shell, requiring
                  mobile CPUs to download, parse, and execute hefty JavaScript bundles.
                  This locks the main thread for 120ms (TBT), stalling visual paint
                  (LCP) at 3.6s.
                </p>
                <p>
                  <strong class="font-bold text-purple-950"
                    >Zero-JS Delivery:</strong
                  > Astro serves pure pre-rendered HTML without client-side runtime
                  overhead (*Zero-JS by default*), painting critical content in 1.9s
                  with zero main-thread contention.
                </p>
              </div>
            </div>
          </div>

          <!-- Telemetry Table 2: Apache JMeter (Newspaper Ledger Style) -->
          <div class="flex flex-col gap-1.5 pt-2">
            <div
              class="flex justify-between items-baseline font-mono text-[10px]"
            >
              <span class="font-bold text-black uppercase tracking-wider">
                Table 2: Concurrency Stress Test (Apache JMeter)
              </span>
              <span class="text-[#666]"
                >Concurrent Stress Simulation (100–300 Virtual Threads)</span
              >
            </div>

            <!-- Newspaper Ledger Table 2 -->
            <div class="overflow-x-auto border-2 border-black bg-white/70">
              <table class="w-full text-left font-mono text-xs border-collapse">
                <thead
                  class="border-b-2 border-black bg-[#ded4b7] text-black text-[9px] uppercase tracking-wider"
                >
                  <tr>
                    <th class="py-2 px-3 border-r border-black/20"
                      >Concurrency</th
                    >
                    <th
                      class="py-2 px-3 border-r border-black/20 text-purple-900 font-extrabold"
                      >Astro TTFB</th
                    >
                    <th
                      class="py-2 px-3 border-r border-black/20 text-sky-900 font-extrabold"
                      >React TTFB</th
                    >
                    <th class="py-2 px-3 text-right">Error Rate</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-black/20 text-[11px]">
                  {
                    researchPaper.metrics.jmeter.map((scen) => (
                      <tr class="odd:bg-transparent even:bg-black/[0.03]">
                        <td class="py-2 px-3 font-semibold text-black border-r border-black/20">
                          {scen.users} Users
                        </td>
                        <td class="py-2 px-3 font-bold text-purple-900 border-r border-black/20">
                          {scen.astroResponseTime}
                        </td>
                        <td class="py-2 px-3 font-bold text-sky-900 border-r border-black/20">
                          {scen.reactResponseTime}
                        </td>
                        <td class="py-2 px-3 text-right font-black text-black">
                          {scen.errorRate}
                        </td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>

            <!-- Key Takeaways: Why React Responded 6-12ms Faster in JMeter (Concise Core Rationale) -->
            <div
              class="p-3 bg-[#e5dcbe] border-l-4 border-sky-800 border-y border-r border-black/30 font-sans text-[10.5px] leading-relaxed text-[#222]"
            >
              <div
                class="flex items-center justify-between border-b border-black/20 pb-1 mb-1.5 font-mono text-[9px] uppercase tracking-wider"
              >
                <span class="font-bold text-sky-950"
                  >Key Takeaway // Why React Responded 6–12ms Faster at Server
                  Gate</span
                >
                <span class="text-[#666]">Chapter IV Analysis</span>
              </div>
              <div class="space-y-1.5">
                <p>
                  <strong class="font-bold text-sky-950"
                    >Payload Disparity:</strong
                  > React serves an empty HTML shell of merely 1.13 KB, enabling the
                  web server to dispatch packets 6–12ms faster across raw network
                  sockets than Astro’s complete 85.52 KB markup document.
                </p>
                <p>
                  <strong class="font-bold text-sky-950"
                    >Perceptual Reality:</strong
                  > This 6ms server edge is invisible to humans and immediately negated
                  in the browser, where Astro's pre-rendered markup saves up to 1,700ms
                  in actual user paint time.
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- COLUMN 3 (RIGHT - 3 COLS): Synthesis, Verdict & Registry -->
        <article class="lg:col-span-3 flex flex-col justify-between gap-6">
          <div class="flex flex-col gap-5">
            <div
              class="border-b border-black/20 pb-1.5 font-mono text-[10px] uppercase tracking-wider text-[#555]"
            >
              <span class="font-bold text-black"
                >( 02 ) Synthesis & Verdict</span
              >
            </div>

            <!-- CORE THESIS CONCLUSIONS -->
            <div
              class="border-2 border-black bg-[#e5dcbe] p-3 flex flex-col gap-2 font-sans text-[11px] leading-relaxed text-[#222]"
            >
              <span
                class="font-mono text-[9px] uppercase tracking-wider font-bold text-black block border-b border-black/20 pb-1"
              >
                Core Thesis Conclusions
              </span>
              <div class="space-y-2 text-[10.5px]">
                <p>
                  <strong class="font-bold text-black"
                    >1. Rendering Dominance:</strong
                  > Astro proves decisively superior across all Core Web Vitals (47.8%
                  faster mobile LCP, 0ms TBT) by eliminating client runtime JavaScript
                  from static content.
                </p>
                <p>
                  <strong class="font-bold text-black"
                    >2. Equal Concurrency Resilience:</strong
                  > Both frameworks maintained flawless server reliability with a
                  0.00% error rate across 300 simultaneous virtual threads.
                </p>
                <p>
                  <strong class="font-bold text-black"
                    >3. Decision Framework:</strong
                  > Astro is the optimal choice for content-first websites, marketing
                  portals, and portfolios. React remains justified for complex client-side
                  applications requiring continuous state updates.
                </p>
              </div>
            </div>

            <!-- PRACTICAL RECOMMENDATIONS -->
            <div
              class="border-2 border-black bg-[#e5dcbe] p-3 flex flex-col gap-2 font-sans text-[11px] leading-relaxed text-[#222]"
            >
              <span
                class="font-mono text-[9px] uppercase tracking-wider font-bold text-black block border-b border-black/20 pb-1"
              >
                Practical Recommendations
              </span>
              <div class="space-y-2 text-[10.5px]">
                <p>
                  <strong class="font-bold text-black"
                    >For Software Engineers:</strong
                  > Align architecture with content dynamics—favoring static islands
                  for display sites—rather than defaulting to single-page application
                  setups.
                </p>
                <p>
                  <strong class="font-bold text-black"
                    >For Future Research:</strong
                  > Evaluate performance across throttled edge-network conditions
                  (variable 3G/4G) and isolate bare-metal servers to eliminate shared
                  cloud virtualization latency.
                </p>
              </div>
            </div>

            <!-- Institutional Registry -->
            <div
              class="border border-black/30 bg-[#ded4b7] p-3 rounded font-mono text-[9px] space-y-1 text-[#333]"
            >
              <div class="flex justify-between border-b border-black/20 pb-0.5">
                <span class="text-[#666]">Institution:</span>
                <span class="font-bold text-black">Universitas Gunadarma</span>
              </div>
              <div class="flex justify-between border-b border-black/20 pb-0.5">
                <span class="text-[#666]">Faculty Advisor:</span>
                <span class="font-bold text-black">Dwi Widiastuti, MMSI.</span>
              </div>
              <div class="flex justify-between border-b border-black/20 pb-0.5">
                <span class="text-[#666]">Defense Year:</span>
                <span class="font-bold text-black">2026</span>
              </div>
              <div class="flex justify-between">
                <span class="text-[#666]">Academic Status:</span>
                <span class="font-bold text-purple-900"
                  >Successfully Defended (Approved)</span
                >
              </div>
            </div>
          </div>

          <!-- Bottom Action Buttons (Matching Newspaper Aesthetics) -->
          <div class="flex flex-col gap-2.5 pt-4 border-t-2 border-black">
            <a
              href={researchPaper.pdfUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 bg-black hover:bg-[#2b2b2b] text-[#f0e9d4] font-mono text-[11px] font-bold uppercase tracking-wider transition-colors shadow"
            >
              <span>Download Manuscript (PDF)</span>
              <span class="font-serif">↓</span>
            </a>

            <button
              id="newspaper-copy-bibtex"
              class="w-full py-2.5 px-4 border-2 border-black bg-transparent hover:bg-black/10 text-black font-mono text-[10px] font-bold uppercase tracking-wider transition-colors cursor-pointer text-center"
              data-bibtex={researchPaper.bibtex}
            >
              [ <span id="newspaper-bibtex-text">Copy BibTeX Citation</span> ]
            </button>
          </div>
        </article>
      </div>

      <!-- Newspaper Broadsheet Footer -->
      <footer
        class="mt-8 pt-3 border-t-2 border-black flex flex-wrap items-center justify-between font-mono text-[10px] text-[#555] uppercase tracking-wider"
      >
        <span
          >Undergraduate Thesis Archive — Farhan Harits Prakoso (50423457)</span
        >
        <span>Universitas Gunadarma © 2026</span>
      </footer>
    </article>
  </main>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    // Ensure the research newspaper opens directly at the top
    window.scrollTo(0, 0);
    const lenis = (window as any).lenis;
    if (lenis) {
      lenis.scrollTo(0, { immediate: true });
    }

    const copyBtn = document.getElementById("newspaper-copy-bibtex");
    const copyBtnText = document.getElementById("newspaper-bibtex-text");

    if (copyBtn && copyBtnText) {
      copyBtn.addEventListener("click", async () => {
        const bibtex = copyBtn.getAttribute("data-bibtex") || "";
        try {
          await navigator.clipboard.writeText(bibtex);
          copyBtnText.textContent = "Copied to Clipboard! ✓";
          setTimeout(() => {
            copyBtnText.textContent = "Copy BibTeX Citation";
          }, 2500);
        } catch (err) {
          console.error("Failed to copy citation", err);
        }
      });
    }
  });
</script>
